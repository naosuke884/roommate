---
import '@fontsource/zen-maru-gothic/latin-700.css';

interface Props {
  title?: string;
  /** 検索結果やリンクの共有で出る説明。省くとサイト全体の説明 */
  description?: string;
  /** 検索に載せないページ。canonical と og:url も付けない */
  noindex?: boolean;
}

const SITE_DESCRIPTION = '同じ日に同じコースを遊ぶ人と、スコアを競うブラウザゲーム。';

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | roommate` : 'roommate';
const canonical = new URL(Astro.url.pathname, Astro.site);
// リンクの共有で出る画像。どのページも同じものを使う
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="roommate" />
    <meta property="og:title" content={title ?? 'roommate'} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="roommate のロゴ" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <a href="/" class="brand">
        <img src="/logo.svg" alt="" width="32" height="32" />
        <span>roommate</span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav aria-label="サイトの情報">
        <a href="/terms/">利用規約</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  /* 配色は HAY-134 で決めたもの。オレンジと黄は面と図形に使い、文字には使わない */
  :root {
    color-scheme: light dark;
    --bg: #fffaf0;
    --fg: #3a2a1e;
    --muted: #7a6656;
    --line: #efe3cf;
    --surface: #ffffff;
    /* ゲームの画像の代わりの面。シンボルの黄の丸が埋もれない薄い色 */
    --soft: #fff0d2;
    --apricot: #ff9852;
    --butter: #ffd36b;
    --overlap: #f5b04a;
    /* オレンジと黄の面に載せる文字。どちらのテーマでもこげ茶 */
    --on-accent: #3a2a1e;
    --font-brand: 'Zen Maru Gothic', system-ui, sans-serif;
    --radius: 1.125rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #272019;
      --fg: #fff1dc;
      --muted: #bca88f;
      --line: #3d3328;
      --surface: #30281f;
      --soft: #3b3024;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, sans-serif;
    line-height: 1.7;
    /* 中身が短いページでもフッターを画面の下に置く */
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  header,
  main,
  footer {
    box-sizing: border-box;
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
  }

  main {
    flex: 1 0 auto;
    padding-bottom: 3rem;
  }

  @media (min-width: 40rem) {
    header,
    main,
    footer {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }

  a {
    color: inherit;
  }

  footer {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  :focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .brand span {
    font-family: var(--font-brand);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
  }

  /* 遊ぶ・戻るなど、ページの主な操作 */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.75rem;
    border-radius: 999px;
    background: var(--apricot);
    box-shadow: 0 2px 0 var(--overlap);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .button:hover {
    filter: brightness(1.05);
  }

  .button:active {
    box-shadow: none;
    transform: translateY(2px);
  }

  .button-small {
    padding: 0.375rem 1.125rem;
    font-size: 0.875rem;
  }
</style>
