---
interface Props {
  title?: string;
  /** 検索結果やリンクの共有で出る説明。省くとサイト全体の説明 */
  description?: string;
  /** 検索に載せないページ。canonical と og:url も付けない */
  noindex?: boolean;
}

const SITE_DESCRIPTION = '同じ日に同じコースを遊ぶ人と、スコアを競うブラウザゲーム。';

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | roommate` : 'roommate';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="roommate" />
    <meta property="og:title" content={title ?? 'roommate'} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <header>
      <a href="/" class="brand">
        roommate
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf7;
    --fg: #1d1d1b;
    --muted: #6b6b66;
    --line: #e2e2dc;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161614;
      --fg: #ecece6;
      --muted: #9a9a93;
      --line: #2e2e2a;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, sans-serif;
    line-height: 1.6;
  }

  header,
  main {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  .brand {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }
</style>
