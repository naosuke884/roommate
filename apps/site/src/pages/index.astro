---
import { games, playUrl } from '@roommate/catalog';
import { Image } from 'astro:assets';
import Playing from '../components/Playing.tsx';
import TopScore from '../components/TopScore.tsx';
import { API_ORIGIN } from '../config.ts';
import Base from '../layouts/Base.astro';
import { gameImages } from '../games.ts';
---

<Base>
  <h1 class="lead">同じ日に同じコースを遊ぶ人と、スコアを競うブラウザゲーム。</h1>

  <h2 class="visually-hidden">ゲーム</h2>
  <ul class="games">
    {games.map((game) => (
      <li class="game">
        {/* 画像の無いゲームは、ロゴのシンボルを置く */}
        <div class="thumb">
          {gameImages[game.slug] ? (
            <Image
              src={gameImages[game.slug]!}
              alt=""
              widths={[480, 960]}
              sizes="(min-width: 40rem) 20rem, calc(100vw - 2.5rem)"
            />
          ) : (
            <img src="/logo.svg" alt="" width="56" height="56" />
          )}
        </div>
        <div class="body">
          <h3>
            <a href={`/games/${game.slug}/`}>{game.title}</a>
          </h3>
          <p>{game.description}</p>
          <div class="meta">
            <div class="stats">
              <TopScore client:load apiOrigin={API_ORIGIN} game={game.slug} />
              <Playing client:load apiOrigin={API_ORIGIN} game={game.slug} />
            </div>
            {/* ゲームは配信用ドメインを直接開いて遊ぶ。戻るボタンでこのページへ戻れるよう、同じタブで移る */}
            <a class="button button-small" href={playUrl(game.slug)}>
              遊ぶ
            </a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lead {
    max-width: 32rem;
    margin: 0.5rem 0 1.75rem;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.7;
    text-wrap: balance;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    /* 枠は指したときとキーボードで選んだときだけ出す。幅は取っておき、出ても中身がずれないようにする */
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .game:has(h3 a:hover),
  .game:has(h3 a:focus-visible) {
    border-color: var(--overlap);
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--soft);
  }

  .thumb img:not([src$='.svg']) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.375rem;
    padding: 0.875rem 1rem 1rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-brand);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  /* カードのどこを押してもゲームページへ移る */
  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .stats {
    display: grid;
    gap: 0.125rem;
  }

  .stats :global(.playing) {
    font-size: 0.8125rem;
  }

  /* 遊ぶボタンは、カード全体のリンクより手前に出す */
  .meta .button {
    position: relative;
  }

  :global(.top-score) {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.top-score b) {
    color: var(--fg);
    font-size: 0.9375rem;
  }
</style>
