---
import { games, playUrl } from '@roommate/catalog';
import TopScore from '../components/TopScore.tsx';
import { API_ORIGIN } from '../config.ts';
import Base from '../layouts/Base.astro';
---

<Base>
  <h1 class="lead">同じ日に同じコースを遊ぶ人と、スコアを競うブラウザゲーム。</h1>

  <h2 class="visually-hidden">ゲーム</h2>
  <ul class="games">
    {games.map((game) => (
      <li class="game">
        {/* ゲームごとの画像は HAY-117 で決める。それまではロゴのシンボルを置く */}
        <div class="thumb">
          <img src="/logo.svg" alt="" width="56" height="56" />
        </div>
        <div class="body">
          <h3>
            <a href={`/games/${game.slug}/`}>{game.title}</a>
          </h3>
          <p>{game.description}</p>
          <div class="meta">
            <TopScore client:load apiOrigin={API_ORIGIN} game={game.slug} />
            {/* ゲームは配信用ドメインを直接開いて遊ぶ。戻るボタンでこのページへ戻れるよう、同じタブで移る */}
            <a class="button button-small" href={playUrl(game.slug)}>
              遊ぶ
            </a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .lead {
    max-width: 32rem;
    margin: 0.5rem 0 1.75rem;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.7;
    text-wrap: balance;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .game {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .game:has(h3 a:hover) {
    border-color: var(--overlap);
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--soft);
  }

  .body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.375rem;
    padding: 0.875rem 1rem 1rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-brand);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  /* カードのどこを押してもゲームページへ移る */
  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  /* 遊ぶボタンは、カード全体のリンクより手前に出す */
  .meta .button {
    position: relative;
  }

  :global(.top-score) {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.top-score b) {
    color: var(--fg);
    font-size: 0.9375rem;
  }
</style>
