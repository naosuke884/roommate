{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roommate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // 部屋の WebSocket はトークンを query で受け取るので、ログに残さない
    "redact_query_string": true,
  },
  // 使われなかった匿名 ID を消す(src/index.ts の scheduled)。UTC 3:17
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [{ "pattern": "api.roommate.hayashi-naoki.com", "custom_domain": true }],
  "vars": {
    // 追加で API を呼べる origin。カンマ区切り。
    // サイトと配信用 origin は packages/catalog の siteOrigin / playOrigin を常に許す
    "ALLOWED_ORIGINS": "",
  },
  "secrets": {
    "required": ["JWT_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // database_id は書かない。wrangler がこの名前で既存の DB に繋ぐか、無ければ作る
      "database_name": "roommate",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "PLAYER_ISSUE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "SCORE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "NAME_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // プレイヤーごとの部屋への接続。ゲームは日付が変わるときと、切れたときに入り直すだけ
      "name": "ROOM_JOIN_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
