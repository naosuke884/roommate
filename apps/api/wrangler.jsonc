{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roommate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "vars": {
    // 追加で API を呼べる origin。カンマ区切り。
    // サイトと配信用 origin は packages/catalog の siteOrigin / playOrigin を常に許す
    "ALLOWED_ORIGINS": "https://roommate-site.884naoki-dev.workers.dev",
  },
  "secrets": {
    "required": ["JWT_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // database_id は書かない。wrangler がこの名前で既存の DB に繋ぐか、無ければ作る
      "database_name": "roommate",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "PLAYER_ISSUE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "SCORE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
